# PrimeContractorOS - Required Environment Variables
# Copy this file to .env and fill in real values. Never commit real secrets.

# Database
DATABASE_URL=

# Authentication
JWT_SECRET=

# Email (Resend)
RESEND_API_KEY=

# AI / LLM
OPENAI_API_KEY=

# Payments (Stripe)
STRIPE_SECRET_KEY=

# Analytics (frontend-safe, prefixed with VITE_)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# OAuth (platform)
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=

# Internal Forge API (optional)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
